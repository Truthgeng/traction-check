# ---------- Mode ----------
# Demo: MOCK=1 (default). Sample data, no wallet, no payments.
# Test: MOCK=0 and SANDBOX=1. Real X data, paid with free test USDC on Celo Sepolia
#       (the buy gateway's faucet tops the test wallet up). Users are not charged.
# Live: MOCK=0 and SANDBOX=0. Everything real on Celo mainnet.
MOCK=1
SANDBOX=0
# Test-mode wallet. TEST FUNDS ONLY, never send real money to it.
SANDBOX_PRIVATE_KEY=

# ---------- Agent wallet (the buyer) ----------
# Private key of a FRESH wallet used only by this agent to pay buy services.
# Fund it with a small float of USDC or USDT on Celo mainnet. Treat it as spent.
AGENT_PRIVATE_KEY=
# Token the agent pays buy services with: USDC, USDT or USAT
AGENT_PAY_TOKEN=USDC

# ---------- User payments (the seller side) ----------
# Wallet that receives what users pay per check. Can be your own wallet.
# Judges need this PayTo address for x402 activity.
PAY_TO=
# API key from https://x402.celo.org (connect wallet, create key, sign). Server only.
X402_API_KEY=
# Price per check in atomic units (6 decimals). 50000 = $0.05
CHECK_PRICE_ATOMIC=50000
# Free checks each visitor gets before paying, and a daily ceiling on free checks
FREE_CHECKS=2
FREE_DAILY_LIMIT=300
# Any long random string. Signs the free-check cookie so it can't be edited.
FREE_CHECK_SECRET=

# ---------- Spend caps per paid call (whole token units) ----------
MAX_X_SEARCH=0.02
MAX_LLM=0.02
MAX_RPC=0.02

# ---------- Identity (ERC-8004) and attribution ----------
# Your live site, e.g. https://traction-check.vercel.app
SITE_URL=
# Attribution code Loops House gives you when you enroll (celo_xxxxxxxxxxxx)
ATTRIBUTION_CODE=
# Filled in automatically by `npm run register`
AGENT_ID=
